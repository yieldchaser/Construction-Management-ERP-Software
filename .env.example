# ==============================================================================
# SiteFlow Core Configuration Variables Example
# Copy this file to '.env' and adjust values for local development or production.
# ==============================================================================

# --- DATABASE CONFIGURATION ---
# Local SQLite fallback URL for development and testing:
# DATABASE_URL=sqlite:///./test.db
# PostgreSQL / Supabase connection URL (Production):
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# --- ENVIRONMENT ---
# Set ENVIRONMENT=production on Render and any real deploy. When it is a local
# value (local/development/dev/test/ci) the app may fall back to a throwaway dev
# SECRET_KEY; in any other environment SECRET_KEY is mandatory and the app
# refuses to start without a strong one.
ENVIRONMENT=local

# --- JWT AUTHENTICATION CONFIGURATION ---
# REQUIRED in production. Generate a strong random value:
#   openssl rand -hex 32
# Do NOT reuse the old committed development key. Rotating this value logs out
# all existing sessions (acceptable pre-launch). Leave empty only for local dev.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- OTP / SMS LOGIN ---
# Real OTP login needs an SMS provider. Implemented against MSG91 (India). Create
# an MSG91 account, register an OTP template, then set the key and template id
# below on Render. When SMS_PROVIDER_API_KEY is empty, real SMS is disabled and
# ONLY the demo allowlist can log in (with OTP_DEMO_CODE); all other numbers get
# a 503. The real code is never returned in an API response.
SMS_PROVIDER=msg91
SMS_PROVIDER_API_KEY=
MSG91_SENDER_ID=SITEFL
MSG91_OTP_TEMPLATE_ID=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Comma-separated demo numbers allowed to log in with OTP_DEMO_CODE while no SMS
# provider is configured. Remove/lock down before real launch.
OTP_DEMO_ALLOWLIST=9876543210,+919876543210
OTP_DEMO_CODE=123456

# --- CORS PREVIEW ORIGINS ---
# Regex for THIS project's own Vercel preview deployments only (not all of
# *.vercel.app). Override if the Vercel project slug/scope changes.
# FRONTEND_ORIGIN_REGEX=^https://(construction-management-erp-softwar[a-z0-9-]*|siteflow[a-z0-9-]*)\.vercel\.app$
# Comma-separated explicit prod frontend origins (optional; adds to defaults).
# FRONTEND_URL=https://app.siteflow.co

# --- SUPABASE STORAGE (file blobs: company/project documents) ---
# When BOTH are set, uploaded files move out of the Postgres bytea column into
# Supabase Storage (buckets: company-files, project-files, private). When unset,
# the file routers fall back to storing bytes in the DB `data` column, so local
# dev with SQLite keeps working unchanged.
# Find these in the Supabase dashboard: Project Settings -> API.
SUPABASE_URL=https://yourprojectref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- SENTRY ERROR TRACKING (backend, optional) ---
# When set, the backend reports errors and a small sample of performance traces
# to Sentry. The app runs fine without it: leave empty to disable cleanly.
# Find the DSN in your Sentry project: Settings -> Client Keys (DSN).
SENTRY_DSN=

# --- GOOGLE SHEETS INTEGRATION (optional) ---
# OAuth client credentials from Google Cloud Console (APIs & Services ->
# Credentials -> OAuth client ID). Register the backend callback as a redirect
# URI: {BACKEND_PUBLIC_URL}/apis/v3/integrations/google-sheets/callback
# When these are empty the connect flow returns a clear "not configured" error.
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
# Public base URL of this backend (no trailing slash), used to build the OAuth
# redirect URI. Falls back to the incoming request URL when empty.
BACKEND_PUBLIC_URL=https://construction-erp-backend-73vm.onrender.com
# Public base URL of the frontend, used to redirect back after OAuth. Falls
# back to the first configured frontend origin when empty.
FRONTEND_PUBLIC_URL=

# --- ADMIN MIGRATION SECRET (one-off migrations only) ---
# Temporary, for one-off admin-triggered migrations (e.g. the file-storage
# backfill). NOT a general auth mechanism. The admin migration routes read it
# from the `X-Admin-Secret` header and always return 403 when it is empty, so
# never ship a default. Generate a random value per deployment:
#   openssl rand -hex 32
# and set it as a Render env var (it is never passed as a URL parameter).
ADMIN_MIGRATION_SECRET=

# --- RATE LIMITING (slowapi) ---
# Where limiter counters live. Empty means per-process memory: every uvicorn
# worker or Render instance keeps its OWN counter, so a "5/hour" policy is
# really "5/hour per worker" and clients see alternating 200/429 (audit
# R2-295 / R2-299). Set a shared Redis URL in any multi-worker deploy:
#   RATE_LIMIT_STORAGE_URI=redis://localhost:6379/0
RATE_LIMIT_STORAGE_URI=
# Behind Cloudflare/Render the socket peer is the edge proxy, so without this
# every visitor shares one bucket keyed on the proxy IP. Flip to true ONLY
# after verifying your edge overwrites these headers: Cloudflare always sets
# CF-Connecting-IP itself, while X-Forwarded-For's first hop is client-
# supplied and spoofable, letting callers rotate keys to dodge limits.
# RATE_LIMIT_TRUST_PROXY_HEADERS=false

# --- FRONTEND ENVIRONMENT VARIABLES (Next.js) ---
# Set the backend URL for API communications from the browser
NEXT_PUBLIC_API_URL=http://localhost:8000
