    {
      "id": "concrete_volume_calculator",
      "name": "Concrete Volume Calculator",
      "top_level_tabs": ["Slab / Wall / Beam", "Rectangular Column", "Circular Column", "Stairs", "Custom Volume"],
      "modes": {
        "slab_wall_beam": {
          "inputs": [
            { "name": "length_m" },
            { "name": "width_m" },
            { "name": "thickness_m", "note": "slab typical 0.10-0.20, or beam depth" }
          ],
          "formula": "volume_m3 = length_m * width_m * thickness_m"
        },
        "rectangular_column": {
          "inputs": [
            { "name": "length_m" },
            { "name": "width_breadth_m" },
            { "name": "height_m" },
            { "name": "no_of_columns" }
          ],
          "formula": "volume_m3 = length_m * width_breadth_m * height_m * no_of_columns"
        },
        "circular_column": {
          "inputs": [
            { "name": "diameter_m", "note": "full diameter, not radius" },
            { "name": "height_m" },
            { "name": "no_of_columns" }
          ],
          "formula": "volume_m3 = PI/4 * diameter_m^2 * height_m * no_of_columns"
        },
        "stairs": {
          "inputs": [
            { "name": "riser_height_m", "default": 0.15 },
            { "name": "tread_width_m", "default": 0.25 },
            { "name": "stair_width_m", "note": "clear width", "default": 1.20 },
            { "name": "waist_slab_m", "default": 0.15 },
            { "name": "no_of_steps", "default": 14 }
          ],
          "formula": "volume_m3 = no_of_steps * stair_width_m * ( (riser_height_m * tread_width_m / 2) + (waist_slab_m * sqrt(riser_height_m^2 + tread_width_m^2)) )",
          "formula_note": "shown live in the UI itself, not just in article text -- confirms UI transparency pattern"
        },
        "custom_volume": {
          "inputs": [{ "name": "total_volume_m3", "type": "direct_entry" }]
        }
      },
      "shared_inputs": [
        {
          "name": "concrete_mix_grade",
          "type": "dropdown_with_inline_description",
          "options": [
            { "grade": "M5", "ratio": "1:5:10", "use": "Blinding / levelling" },
            { "grade": "M7.5", "ratio": "1:4:8", "use": "Mass concrete, PCC" },
            { "grade": "M10", "ratio": "1:3:6", "use": "Plain concrete, PCC foundations" },
            { "grade": "M15", "ratio": "1:2:4", "use": "PCC, non-structural works" },
            { "grade": "M20", "ratio": "1:1.5:3", "use": "RCC slabs, beams, columns (most common)" },
            { "grade": "M25", "ratio": "1:1:2", "use": "High-strength RCC, structural elements" }
          ],
          "note": "calculator deliberately stops at M25; M30+ requires design mix, not nominal ratio"
        },
        { "name": "wastage_pct", "type": "number", "default": 5, "hint": "5% slab · 7-10% columns/footings" },
        {
          "name": "local_material_rates",
          "type": "collapsible_optional_group",
          "fields": [
            { "name": "cement_rate_per_bag", "hint_india": "Rs 350-450", "hint_uae": "AED 25-35" },
            { "name": "sand_rate_per_m3", "hint_india": "Rs 700-1500", "hint_uae": "AED 50-90" },
            { "name": "aggregate_rate_per_m3", "hint_india": "Rs 1200-1800", "hint_uae": "AED 70-100" }
          ]
        },
        { "name": "reset_button" }
      ],
      "outputs": [
        "wet_concrete_volume_m3",
        "dry_volume_m3",
        "cement_bags",
        "cement_weight_kg",
        "sand_m3_or_kg",
        "aggregate_m3_or_kg",
        "estimated_material_cost"
      ],
      "formulas": {
        "dry_volume_m3": "wet_volume_m3 * 1.54 * (1 + wastage_pct/100)",
        "cement_volume_fraction": "cement_ratio_part / sum_of_ratio_parts",
        "cement_volume_m3": "dry_volume_m3 * cement_volume_fraction",
        "cement_bags": "ceil(cement_volume_m3 / 0.0347)  // 1 bag (50kg) = 50/1440 = 0.0347 m3, always round up",
        "cement_weight_kg": "cement_bags * 50",
        "sand_volume_m3": "dry_volume_m3 * (sand_ratio_part / sum_of_ratio_parts)",
        "aggregate_volume_m3": "dry_volume_m3 * (aggregate_ratio_part / sum_of_ratio_parts)"
      },
      "constants": {
        "dry_to_wet_factor": 1.54,
        "cement_bag_kg": 50,
        "cement_bulk_density_kg_per_m3": 1440
      },
      "reference_tables": {
